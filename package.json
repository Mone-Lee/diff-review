{
  "name": "diff-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "review": "tsx src/cli/start.ts",
    "review:dev": "tsx src/cli/start.ts --dev",
    "dev": "vite --host 127.0.0.1 --open",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "express": "^5.2.1",
    "github-slugger": "^2.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
