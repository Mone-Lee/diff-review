{
  "name": "local-diff-reviewer",
  "version": "2.0.8",
  "private": false,
  "description": "Open a local GitHub-style diff review Web UI for the current repository.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mone-Lee/diff-review.git"
  },
  "homepage": "https://github.com/Mone-Lee/diff-review#readme",
  "bugs": {
    "url": "https://github.com/Mone-Lee/diff-review/issues"
  },
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "local-diff-reviewer": "dist/cli/start.js"
  },
  "files": [
    "dist",
    "docs/images",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "review": "tsx src/cli/start.ts",
    "review:dev": "tsx src/cli/start.ts --dev",
    "dev": "npm run review:dev",
    "web:dev": "vite --host 127.0.0.1 --open",
    "build": "npm run typecheck && vite build && node scripts/build-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "skill:check": "node scripts/validate-skill.mjs",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "npm run build",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "antd": "^6.3.7",
    "esbuild": "^0.27.7",
    "less": "^4.6.4",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.12"
  }
}
